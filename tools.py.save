import json
from pathlib import Path


PRODUCT_FILE = Path(__file__).parent / "products.json"

INTENT_WEIGHTS = {
    "coding": {
        "cpu": 5,
        "ram": 5,
        "storage": 3,
        "gpu": 2,
        "battery": 3,
        "weight": 2,
    },
    "gaming": {
        "cpu": 4,
        "ram": 4,
        "storage": 2,
        "gpu": 6,
        "display": 4,
        "refresh": 4,
    },
    "student": {
        "price": 4,
        "battery": 4,
        "weight": 4,
        "ram": 3,
        "storage": 3,
    },
    "portable": {
        "weight": 6,
        "battery": 5,
        "display": 2,
    },
    "performance": {
        "cpu": 6,
        "gpu": 6,
        "ram": 5,
        "storage": 3,
    },
    "ml": {
        "gpu": 7,
        "ram": 6,
        "cpu": 5,
        "storage": 3,
    },
}

def load_products():
    with open(PRODUCT_FILE, "r", encoding="utf-8") as file:
        data = json.load(file)
    if isinstance(data, dict) and "products" in data:
        return data["products"]

    return data

def detect_intents(query):
    query = query.lower()

    intents = []

    for intent in INTENT_WEIGHTS:
        if intent in query:
            intents.append(intent)

    return intents

def extract_number(text):
    import re

    if text is None:
        return None

    match = re.search(r"\d+(?:\.\d+)?", str(text))

    if match:
        return float(match.group())

    return None


def score_product(product, intents, max_price=None):
    score = 

    specs = product.get("specifications", {})
    text = " ".join([
        product.get("name", ""),
        product.get("brand", ""),
        product.get("category", ""),
        " ".join(product.get("tags", [])),
        " ".join(product.get("use_cases", [])),
    ]).lower()

    processor = str(specs.get("processor") or "").lower()
    gpu = str(specs.get("gpu") or "").lower()
    ram = str(specs.get("ram") or "").lower()
    storage = str(specs.get("storage") or "").lower()
    display = str(specs.get("display") or "").lower()

    ram_gb = extract_number(ram)
    storage_gb = extract_number(storage)

    # -------------------------
    # Intent-based scoring
    # -------------------------

    for intent in intents:

        # Coding
        if intent == "coding":
            if "coding" in text:
                score += 20

            if ram_gb and ram_gb >= 16:
                score += 12

            if "i7" in processor or "ultra 7" in processor:
                score += 10

            if "i5" in processor or "ultra 5" in processor:
                score += 6

            if storage_gb and storage_gb >= 512:
                score += 6

            if "gaming" in text:
                score -= 8

        # Gaming
        elif intent == "gaming":
            if "gaming" in text:
                score += 30

            if any(x in gpu for x in [
                "rtx", "radeon", "arc"
            ]):
                score += 12

            if "144hz" in display or "165hz" in display:
                score += 10

        # Performance
        elif intent == "performance":
            if "i9" in processor or "ultra 9" in processor:
                score += 25
            elif "i7" in processor or "ultra 7" in processor:
                score += 20
            elif "i5" in processor or "ultra 5" in processor:
                score += 12

            if any(x in gpu for x in [
                "rtx 40", "rtx 50", "radeon"
            ]):
                score += 20

            if ram_gb and ram_gb >= 32:
                score += 15
            elif ram_gb and ram_gb >= 16:
                score += 8

        # Machine learning
        elif intent == "ml":
            if any(x in gpu for x in [
                "rtx", "radeon"
            ]):
                score += 30

            if "nvidia" in gpu:
                score += 12

            if ram_gb and ram_gb >= 32:
                score += 15
            elif ram_gb and ram_gb >= 16:
                score += 8

            if "i7" in processor or "ultra 7" in processor:
                score += 12

        # Student
        elif intent == "student":
            if "student" in text or "college" in text:
                score += 15

        # Portable
        elif intent == "portable":
            if "portable" in text:
                score += 20

            weight = extract_number(specs.get("weight"))

            if weight is not None:
                if weight <= 1.4:
                    score += 15
                elif weight <= 1.7:
                    score += 8

    # General quality
    if ram_gb and ram_gb >= 16:
        score += 5

    if storage_gb and storage_gb >= 512:
        score += 4

    # Budget bonus
    price = product.get("price_inr")

    if max_price is not None and price is not None:
        remaining = max_price - price

        if remaining >= 0:
            score += 15

    return score

def search_products(query="", max_price=None, category=None):
    products = load_products()

    query = str(query or "").lower().strip()
    intents = detect_intents(query)

    # Normalize max price
    if max_price is not None:
        try:
            max_price = float(max_price)
        except (ValueError, TypeError):
            max_price = None

    # Normalize category
    if category is not None:
        category = str(category).strip().lower()
        if category in ("", "none", "null", "any", "all"):
            category = None

    query_words = [
        word.strip(".,!?")
        for word in query.split()
        if len(word.strip(".,!?")) > 1
    ]

    scored_results = []

    for product in products:
        name = product.get("name", "")
        brand = product.get("brand", "")
        product_category = product.get("category", "")
        tags = product.get("tags", [])
        use_cases = product.get("use_cases", [])
        specifications = product.get("specifications", {})

        searchable_text = " ".join([
            name,
            brand,
            product_category,
            " ".join(tags),
            " ".join(use_cases),
            " ".join(str(v) for v in specifications.values())
        ]).lower()

        score = 0

        # Category match
        if category:
            if category in product_category.lower():
                score += 30
            else:
                continue

        # Price filter
        price = product.get("price_inr")
        if max_price is not None and price is not None:
            if price > max_price:
                continue
            score += 20

        # Exact query match
        if query and query in searchable_text:
            score += 25

        # Individual word matches
        for word in query_words:
            if word in name.lower():
                score += 15
            elif word in product_category.lower():
                score += 12
            elif word in searchable_text:
                score += 5

        # Use-case matching
        for use_case in use_cases:
            if use_case.lower() in query:
                score += 10

        # Specification matching
        for key, value in specifications.items():
            spec_text = str(value).lower()

            if "16gb" in query and "16gb" in spec_text:
                score += 25

            if "32gb" in query and "32gb" in spec_text:
                score += 25

            if "512gb" in query and "512gb" in spec_text:
                score += 15

            if "1tb" in query and "1tb" in spec_text:
                score += 15

            if "ssd" in query and "ssd" in spec_text:
                score += 10

        # Intent-aware scoring
        intent_text = " ".join([
            name,
            product_category,
            " ".join(tags),
            " ".join(use_cases)
        ]).lower()

        for intent in intents:

            if intent == "coding":
                if "coding" in intent_text:
                    score += 25

                # Prefer productivity/dev laptops over gaming ones
                if "gaming" in intent_text:
                    score -= 8

            elif intent == "gaming":
                if "gaming" in intent_text:
                    score += 30

            elif intent == "student":
                if "student" in intent_text or "college" in intent_text:
                    score += 20

            elif intent == "portable":
                if "portable" in intent_text:
                    score += 20

            elif intent == "performance":
                if "performance" in intent_text:
                    score += 20

            elif intent == "ml":
                if "ml" in intent_text or "machine learning" in intent_text:
                    score += 30

        if score > 0:
            scored_results.append((score, product))

    # Highest score first
    scored_results.sort(
        key=lambda item: (
            item[0],
            -(item[1].get("price_inr") or 0)
        ),
        reverse=True
    )

    return [product for score, product in scored_results[:10]]
